# ConfRadar Codespaces Environment Variables Template
# Copy this file and configure your GitHub Codespace secrets

# Database Configuration (auto-configured in Codespaces)
DATABASE_URL=postgresql+psycopg2://confradar:confradar@postgres:5432/confradar

# Dagster Configuration
DAGSTER_HOME=/workspace/packages/confradar/dagster_home

# OpenAI API Configuration
# Set ONE of these in your GitHub Codespace secrets:

# Option 1: Service account key (preferred for organization usage)
# CONFRADAR_SA_OPENAI=your-service-account-key-here

# Option 2: Personal OpenAI API key
# OPENAI_API_KEY=sk-your-openai-api-key-here

# PostgreSQL Configuration (default values, usually don't need to change)
POSTGRES_USER=confradar
POSTGRES_PASSWORD=confradar
POSTGRES_DB=confradar

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# LiteLLM Configuration
LITELLM_LOG=info

# Frontend Configuration
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Optional: Enable file watching polling for Docker on Windows/Mac
# CHOKIDAR_USEPOLLING=true
# WATCHPACK_POLLING=true
